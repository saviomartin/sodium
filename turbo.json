{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "CI",
    "NEXT_DIST_DIR",
    "SITE_URL",
    "SUPABASE_URL",
    "SUPABASE_SECRET_KEY",
    "SUPABASE_DB_URL",
    "WORK_DIR",
    "LOG_LEVEL",
    "WORKER_CONCURRENCY",
    "AI_GATEWAY_API_KEY",
    "VERCEL_OIDC_TOKEN",
    "AI_MODEL",
    "AI_FALLBACK_MODEL",
    "RUN_AI_GATEWAY_INTEGRATION",
    "RUN_STRIPE_E2E",
    "PLAYWRIGHT_BASE_URL",
    "VERCEL_AUTOMATION_BYPASS_SECRET",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "STRIPE_REPOSITORY_PRICE_ID",
    "STRIPE_PORTAL_CONFIGURATION_ID",
    "STRIPE_MODE",
    "GITHUB_WEBHOOK_SECRET",
    "CRON_SECRET",
    "MANIFEST_SIGNING_KEY_ID",
    "MANIFEST_SIGNING_PRIVATE_KEY",
    "MANIFEST_SIGNING_KEY_FILE",
    "SODIUM_MANIFEST_JWKS",
    "SODIUM_LOADER_FILE",
    "SODIUM_DEV_KEY_FILE",
    "SODIUM_ENVIRONMENT",
    "SODIUM_PUBLIC_URL",
    "SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID",
    "SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET",
    "STRIPE_PUBLISHABLE_KEY",
    "STRIPE_MCP_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
