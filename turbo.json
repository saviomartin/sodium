{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "CI",
    "NO_COLOR",
    "TERM",
    "SODIUM_PLAIN",
    "NEXT_DIST_DIR",
    "SITE_URL",
    "SUPABASE_SECRET_KEY",
    "SUPABASE_DB_URL",
    "PLAYWRIGHT_BASE_URL",
    "VERCEL_AUTOMATION_BYPASS_SECRET",
    "SODIUM_ENVIRONMENT",
    "SODIUM_CONFIG_DIR",
    "SODIUM_ENDPOINT",
    "SODIUM_TOKEN",
    "SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID",
    "SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
