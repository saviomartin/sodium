{
  "name": "@sodium/worker",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "exports": {
    "./runner": "./src/runner.ts",
    "./db": "./src/db.ts",
    "./env": "./src/env.ts",
    "./log": "./src/log.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "start": "tsx --env-file=.env src/main.ts",
    "lint": "eslint --max-warnings 0 src test",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run test/db-rls.test.ts"
  },
  "dependencies": {
    "@sodium/analyzer": "workspace:*",
    "@sodium/contracts": "workspace:*",
    "@supabase/supabase-js": "^2.112.4",
    "ai": "^7.0.83",
    "octokit": "^5.0.5",
    "postgres": "^3.4.9",
    "tar": "^7.5.22",
    "tsx": "^4.23.12",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.3.0",
    "dotenv": "16.0.3",
    "eslint": "10.9.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  }
}
