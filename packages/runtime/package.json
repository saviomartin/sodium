{
  "name": "sodium-webmcp-sdk",
  "version": "0.2.0",
  "description": "Local WebMCP runtime and telemetry SDK for Sodium",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/sdk.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/types/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "prepack": "node scripts/build.mjs --release && tsc -p tsconfig.build.json",
    "lint": "eslint --max-warnings 0 src test",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "sodium-webmcp-spec": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "esbuild": "^0.28.2",
    "eslint": "10.9.1",
    "happy-dom": "^20.11.12",
    "react": "19.2.8",
    "typescript": "7.0.2",
    "vitest": "^4.1.11",
    "webmcp-types": "^0.1.5"
  }
}
