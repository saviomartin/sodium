{
  "name": "sodium-webmcp-spec",
  "version": "0.2.0",
  "description": "Schemas and validation for sodium.json WebMCP tools",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./signing": {
      "types": "./src/signing.ts",
      "default": "./dist/signing.js"
    },
    "./database": {
      "types": "./src/database.types.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "lint": "eslint --max-warnings 0 src test scripts",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.3.0",
    "esbuild": "^0.28.2",
    "eslint": "10.9.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  }
}
