    "test": "vitest run"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.3.0",
    "sodium-webmcp-spec": "workspace:*",
    "esbuild": "^0.28.2",
    "eslint": "10.9.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  }
}
