{
  "name": "sodium-webmcp",
  "version": "0.1.0",
  "description": "Turn sodium.json into observable WebMCP tools",
  "type": "module",
  "bin": {
    "sodium": "./dist/bin.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint --max-warnings 0 src test",
