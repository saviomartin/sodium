{
  "name": "@resultdev/sodium",
  "version": "0.2.0",
  "description": "Turn sodium.json into observable WebMCP tools",
  "type": "module",
  "bin": {
    "sodium": "dist/bin.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint --max-warnings 0 src test",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "esbuild": "^0.28.2",
    "eslint": "10.9.1",
    "ink-testing-library": "4.0.0",
    "sodium-webmcp-spec": "workspace:*",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "clipboardy": "5.3.2",
    "ink": "6.5.1",
    "react": "19.2.8"
  }
}
