# ── Root (scripts/db-push.mjs + `supabase config push`) ────────────────────
SODIUM_ENVIRONMENT=development
# Direct Postgres connection to the Supabase project (IPv4 session pooler).
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SODIUM_PUBLIC_URL=http://localhost:3000

# GitHub sign-in (the only sign-in method). From a GitHub OAuth App — or the
# Sodium GitHub App's own client credentials — with the callback URL
# https://<project-ref>.supabase.co/auth/v1/callback
# Consumed by supabase/config.toml during `supabase config push`.
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=

# ── apps/web/.env.local ────────────────────────────────────────────────────
# NEXT_PUBLIC_SODIUM_ENVIRONMENT=development
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=<service key — legacy service_role JWT recommended (storage compatibility)>
# SITE_URL=http://localhost:3000
# Manifest signing (one of):
# MANIFEST_SIGNING_KEY_FILE=<abs path>/packages/runtime/keys/dev-manifest-key.json   # dev only
# MANIFEST_SIGNING_KEY_ID=key-2026-1
# MANIFEST_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# GitHub App (required for repository connection and analysis):
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_WEBHOOK_SECRET=<random>
# CRON_SECRET=<random server-only secret used by Vercel Cron and worker kicks>
# NEXT_PUBLIC_GITHUB_APP_SLUG=<your-app-slug>

# ── apps/worker/.env ───────────────────────────────────────────────────────
# SODIUM_ENVIRONMENT=development
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SECRET_KEY=<same service key as above>
# SUPABASE_DB_URL=<same pooler URL as above>
# WORK_DIR=/tmp/sodium-worker
# SODIUM_PUBLIC_URL=http://localhost:3000
# VERCEL_OIDC_TOKEN=<created locally by `vercel env pull`; auto-injected on Vercel>
# AI_GATEWAY_API_KEY=<optional alternative for non-Vercel environments>
# AI_MODEL=openai/gpt-5.6-terra
# AI_FALLBACK_MODEL=anthropic/claude-sonnet-5
# GITHUB_APP_ID=<required>
# GITHUB_APP_PRIVATE_KEY=<required>
