{
  "name": "sodium",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:push": "node scripts/db-push.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "db:test": "pnpm --filter @sodium/worker test:db",
    "db:types": "supabase gen types typescript --linked --schema public > packages/contracts/src/database.types.ts"
  },
  "devDependencies": {
    "postgres": "^3.4.9",
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  }
}
